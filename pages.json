{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "注册"
      }
    },
    {
      "path": "pages/forgotPassword/forgotPassword",
      "style": {
        "navigationBarTitleText": "忘记密码"
      }
    },
    {
      "path": "pages/privacy/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/service-detail/service-detail",
      "style": {
        "navigationBarTitleText": "服务详情"
      }
    },
    {
      "path": "pages/waiting-technician/waiting-technician",
      "style": {
        "navigationBarTitleText": "等待师傅接单"
      }
    },
    {
      "path": "pages/technician-list/technician-list",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/community-feed/community-feed",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/publish-post/publish-post",
      "style": {
        "navigationBarTitleText": "发表动态"
      }
    },
    {
      "path": "pages/technician-portal/technician-portal",
      "style": {
        "navigationBarTitleText": "师傅端"
      }
    },
    {
      "path": "pages/address/address-select",
      "style": {
        "navigationBarTitleText": "选择配送地址"
      }
    },
    {
      "path": "pages/address/address-edit",
      "style": {
        "navigationBarTitleText": "编辑配送地址"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff",
    // #ifdef H5
    "maxWidth": 750,
    "rpxCalcMaxDeviceWidth": 750, // rpx 计算所支持的最大设备宽度，单位 px，默认值为 960
    "rpxCalcBaseDeviceWidth": 560, // rpx 计算使用的基准设备宽度，设备实际宽度超出 rpx 计算所支持的最大设备宽度时将按基准宽度计算，单位 px，默认值为 375
    "rpxCalcIncludeWidth": 750 // rpx 计算特殊处理的值，始终按实际的设备宽度计算，单位 rpx，默认值为 750
    // #endif
  },
  "tabBar": {
    "color": "#808080",
    "selectedColor": "#40C393",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home_selected.png"
      },

      {
        "pagePath": "pages/technician-list/technician-list",
        "text": "专家",
        "iconPath": "static/tabbar/technician.png",
        "selectedIconPath": "static/tabbar/technician_selected.png"
      },
      {
        "pagePath": "pages/community-feed/community-feed",
        "text": "附近",
        "iconPath": "static/tabbar/community-feed.png",
        "selectedIconPath": "static/tabbar/community-feed_selected.png"
      },
      {
        "pagePath": "pages/me/index",
        "text": "我的",
        "iconPath": "static/tabbar/me.png",
        "selectedIconPath": "static/tabbar/me_selected.png"
      }
    ]
  },
  "uniIdRouter": {}
}
