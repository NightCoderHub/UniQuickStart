{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue",
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "",
        "navigationBarBackgroundColor": "#F7F8FA",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/me/index",
      "style": {
        "navigationBarTitleText": "我的",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/register/register",
      "style": {
        "navigationBarTitleText": "",
        "navigationBarBackgroundColor": "#F7F8FA",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/forgot-password/forgot-password",
      "style": {
        "navigationBarTitleText": "",
        "navigationBarBackgroundColor": "#F7F8FA",
        "navigationBarTextStyle": "black"
      }
    },
    {
      "path": "pages/privacy/privacy",
      "style": {
        "navigationBarTitleText": "隐私政策",
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/address/address-select",
      "style": {
        "navigationBarTitleText": "选择配送地址"
      }
    },
    {
      "path": "pages/address/address-edit",
      "style": {
        "navigationBarTitleText": "编辑配送地址"
      }
    },
    {
      "path": "pages/agreement/agreement",
      "style": {
        "navigationBarTitleText": "服务协议"
      }
    },
    {
      "path": "pages/feedback/feedback",
      "style": {
        "navigationBarTitleText": "意见反馈"
      }
    },
    {
      "path": "pages/settings/settings",
      "style": {
        "navigationBarTitleText": "系统设置"
      }
    },
    {
      "path": "pages/not-found/index",
      "style": {
        "navigationBarTitleText": "404"
      }
    }
  ],
  "subPackages": [
    {
      "root": "settingPages",
      "pages": [
        {
          "path": "setting/setting",
          "style": {
            "navigationBarTitleText": "系统设置"
          }
        },
        {
          "path": "account/privacy",
          "style": {
            "navigationBarTitleText": "隐私设置"
          }
        },
        {
          "path": "account/profile",
          "style": {
            "navigationBarTitleText": "个人资料"
          }
        },
        {
          "path": "legal/privacy-policy",
          "style": {
            "navigationBarTitleText": "隐私政策"
          }
        },
        {
          "path": "legal/user-agreement",
          "style": {
            "navigationBarTitleText": "用户协议"
          }
        },
        {
          "path": "help-feedback/help-center",
          "style": {
            "navigationBarTitleText": "帮助中心"
          }
        },
        {
          "path": "help-feedback/feedback",
          "style": {
            "navigationBarTitleText": "意见反馈"
          }
        },
        {
          "path": "about/about",
          "style": {
            "navigationBarTitleText": "关于我们"
          }
        },
        {
          "path": "system-permissions/system-permissions",
          "style": {
            "navigationBarTitleText": "系统权限设置"
          }
        },
        {
          "path": "help-feedback/customer-service",
          "style": {
            "navigationBarTitleText": "客服中心"
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "maxWidth": 750,
    "rpxCalcMaxDeviceWidth": 750,
    "rpxCalcBaseDeviceWidth": 560,
    "rpxCalcIncludeWidth": 750
  },
  "tabBar": {
    "height": "0px",
    "color": "#808080",
    "selectedColor": "#40C393",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home_selected.png"
      },
      {
        "pagePath": "pages/me/index",
        "text": "我的",
        "iconPath": "static/tabbar/me.png",
